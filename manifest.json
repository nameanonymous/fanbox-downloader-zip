{
  "manifest_version": 2,
  "name": "fanbox-downloader",
  "description": "One-click download of works from PIXIV FANBOX post pages",
  "version": "1.5.0",
  "author": "tana3n",
  "icons": {
    "48": "icon_48.png",
    "96": "icon_96.png",
    "128": "icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.fanbox.cc/*"],
      "js": ["fanbox-downloader.js"]
    }
  ],
  "background": {
    "scripts": ["jszip.min.js", "event_page.js"]
  },
  "permissions": [
    "downloads",
    "*://*.fanbox.cc/*"
  ],
  "homepage_url": "https://github.com/nameanonymous/fanbox-downloader-zip/",
  "browser_specific_settings": {
    "gecko": {
      "id": "{c15ebaf3-5c58-434c-aca9-f7d76d86f48e}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
